<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personal Details"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_marginBottom="20dp"/>

        <!-- Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@android:color/white"
            android:elevation="6dp">

            <!-- Name -->
            <EditText
                android:id="@+id/pName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Person Name"
                android:drawableStart="@android:drawable/ic_menu_myplaces"
                android:drawablePadding="10dp"/>

            <!-- Age -->
            <EditText
                android:id="@+id/pAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Age"
                android:inputType="number"
                android:layout_marginTop="12dp"
                android:drawableStart="@android:drawable/ic_menu_today"
                android:drawablePadding="10dp"/>

            <!-- Blood -->
            <EditText
                android:id="@+id/pBlood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Blood Group"
                android:layout_marginTop="12dp"
                android:drawableStart="@android:drawable/ic_menu_edit"
                android:drawablePadding="10dp"/>

            <!-- Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Disability"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_marginTop="18dp"/>

            <!-- Checkboxes -->
            <CheckBox
                android:id="@+id/blind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blind"/>

            <CheckBox
                android:id="@+id/deaf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deaf"/>

            <CheckBox
                android:id="@+id/dumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dumb"/>

            <CheckBox
                android:id="@+id/paralysis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paralysis"/>

            <CheckBox
                android:id="@+id/autism"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Autism"/>

            <!-- FIXED & -->
            <CheckBox
                android:id="@+id/deafDumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deaf &amp; Dumb"/>

            <CheckBox
                android:id="@+id/multiple"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multiple Disabilities"/>

            <!-- Other -->
            <EditText
                android:id="@+id/other"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Other disability"
                android:layout_marginTop="12dp"/>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/backBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Back"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#8B0000"/>

                <Button
                    android:id="@+id/saveBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Next"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#D32F2F"
                    android:layout_marginStart="10dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>